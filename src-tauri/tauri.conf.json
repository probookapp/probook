{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Probook",
  "version": "0.4.0",
  "identifier": "com.probook.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Probook",
        "width": 1280,
        "height": 800,
        "minWidth": 1251,
        "minHeight": 600,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 1280,
        "height": 800,
        "center": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBRjI4RDlBRkVCOTI1MkEKUldRcUpibittbzN5S29pUmdUVXVwZDBVNjdkWUpwU2MxOXFqVHQ4TEFPWm9CU3pUWWxBVjUwc1gK",
      "endpoints": [
        "https://github.com/probookapp/probook/releases/latest/download/latest.json"
      ]
    }
  }
}
